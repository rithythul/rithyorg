1
00:00:00,000 --> 00:00:01,276
អ៉ូ!

2
00:00:01,276 --> 00:00:02,553
ខ្ញុំចង់លាក់ទៀតហើយនៀក

3
00:00:02,553 --> 00:00:03,829
ហើយឥឡូវ

4
00:00:03,829 --> 00:00:05,106
កន្លងមកនេះ

5
00:00:05,106 --> 00:00:06,382
មានត្របែកឆ្ងាញ់

6
00:00:06,382 --> 00:00:07,659
ឆ្ងាញៗៗខ្លាំងហ្មង

7
00:00:07,659 --> 00:00:08,936
នៅស្អាង

8
00:00:08,936 --> 00:00:10,212
ហើយមិនលក់ទាន់បានច្រើនប៉ុន្មានទេ

9
00:00:10,212 --> 00:00:11,489
មានអ្នកស្គាល់អីបានញ៉ាំ

10
00:00:11,489 --> 00:00:12,765
ខ្ញុំក៏ជាម៉ូយដែរ

11
00:00:12,765 --> 00:00:14,042
ហើយខ្ញុំចង់ឃើញត្របែកហ្នឹង

12
00:00:14,042 --> 00:00:15,319
ច្រើន

13
00:00:15,319 --> 00:00:16,595
មានច្រើនទៀត

14
00:00:16,595 --> 00:00:17,872
ដាំតាមបែបធម្មជាតិ

15
00:00:17,872 --> 00:00:19,148
គឺជីធម្មជាតិហ្មង

16
00:00:19,148 --> 00:00:20,425
ហើយរសជាតិនោះ

17
00:00:20,425 --> 00:00:21,702
វាខុសពីត្របែកញ៉ាំនៅកន្លែងផ្សេងហ្មង

18
00:00:21,702 --> 00:00:22,978
ធ្លាប់ញ៉ាំ

19
00:00:22,978 --> 00:00:24,255
ទិញត្របែកនៅផ្សារ

20
00:00:24,255 --> 00:00:25,531
នៅកន្លែងជូរអី

21
00:00:25,531 --> 00:00:26,808
គឺអត់ស្មើហ្មង

22
00:00:26,808 --> 00:00:28,085
អញ្ចឹងមកគិតថា

23
00:00:28,085 --> 00:00:29,361
អូ!

24
00:00:29,361 --> 00:00:30,638
បើសិនជាមានគេដាំអញ្ចឹងច្រើនទៀត

25
00:00:30,638 --> 00:00:31,914
ពិតជាឡូយ

26
00:00:31,914 --> 00:00:33,191
តែឥឡូវនេះ

27
00:00:33,191 --> 00:00:34,468
មាន

28
00:00:34,468 --> 00:00:35,744
ប៉ាម៉ាក់គាត់ដាំ

29
00:00:35,744 --> 00:00:37,021
នៅស្អាង

30
00:00:37,021 --> 00:00:38,297
ហើយឆ្ងាញ់

31
00:00:38,297 --> 00:00:39,574
អញ្ចឹងឥឡូវនេះ

32
00:00:39,574 --> 00:00:40,851
ចែកបងប្អូន

33
00:00:40,851 --> 00:00:42,127
មិត្តភក្តិញ៉ាំសិន

34
00:00:42,127 --> 00:00:43,404
ហើយដែលពិសេសហ្នឹង

35
00:00:43,404 --> 00:00:44,680
គឺរបៀបគាត់ធ្វើជី

36
00:00:44,680 --> 00:00:45,957
ខ្ញុំគិតថាគាត់នឹងបង្ហាញថា

37
00:00:45,957 --> 00:00:47,234
គាត់ធ្វើជីម៉េច

38
00:00:47,234 --> 00:00:48,510
បានជីធម្មជាតិហើយ

39
00:00:48,510 --> 00:00:49,787
ញ៉ាំហើយ

40
00:00:49,787 --> 00:00:51,063
រសជាតិត្របែក

41
00:00:51,063 --> 00:00:52,340
គឺផ្អែមឆ្ងាញ់ធម្មជាតិហ្មង

42
00:00:52,340 --> 00:00:53,617
និយាយទៅទាល់តែសាក

43
00:00:53,617 --> 00:00:54,893
បានសាកបានដឹង

44
00:00:54,893 --> 00:00:56,170
ត្រូវតែសាក

45
00:00:56,170 --> 00:00:57,446
អញ្ចឹងអ្នកណាគេចង់សាក

46
00:00:57,446 --> 00:00:58,723
ប្រាប់មក

47
00:00:58,723 --> 00:01:00,000
យកទៅឱ្យញ៉ាំ។
